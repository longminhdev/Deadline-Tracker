{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "web/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "30 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=api/:path*"
    },
    {
      "source": "/",
      "destination": "/api/index?path="
    },
    {
      "source": "/:path*",
      "destination": "/api/index?path=:path*"
    }
  ]
}
