# Enable the invite-only multi-user beta server.
MULTIUSER_BETA=1

# Supabase project settings (use the server secret only in the backend).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated exact hostnames of approved eLearning calendar feeds.
ICS_ALLOWED_HOSTS=elearning.example.edu.vn

# Generate a 32-byte base64url key and a separate random cron bearer secret.
ICS_ENCRYPTION_KEY=
CRON_SECRET=
